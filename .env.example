# The shared top ten for the Safari stage, kept in Supabase. Copy this file to .env and fill both in.
# Leave them empty and the live project (named in src/game/leaderboard.ts) is used.
# The key is the project's publishable key. It is safe in the page: the table allows reading and inserting only.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_KEY=sb_publishable_your_key
